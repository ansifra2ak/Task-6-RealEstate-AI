FROM node:22-bookworm-slim AS frontend
WORKDIR /src
COPY frontend/phase6/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
COPY frontend/phase6/index.html ./
COPY frontend/phase6/src ./src
RUN npm test && npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MLFLOW_ENABLE_TELEMETRY=false \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \
    BLIS_NUM_THREADS=1 MALLOC_ARENA_MAX=2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home task6 && (getent group 1000 || groupadd -g 1000 rendersecrets) && usermod -a -G 1000 task6
COPY requirements-render.txt requirements-render-lock.txt ./
RUN pip install --no-cache-dir -r requirements-render.txt
COPY backend ./backend
COPY --from=frontend /src/dist ./frontend/phase6/dist
USER task6
EXPOSE 10000
CMD ["python", "-m", "backend.phase11_render"]
